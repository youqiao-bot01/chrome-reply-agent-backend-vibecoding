# 复制为 config.test.yaml；本地冒烟用（SQLite + 本地 Chroma）
# HUBSTUDIO_CONFIG_FILE=tests/test_mock/config.test.yaml uv run python main.py ...

rag:
  embed:
    base_url: "https://api.xiaocaseai.com"
    api_path: "/v1/embeddings"
    api_key_env: "HUBSTUDIO_EMBED_API_KEY"
    model: "text-embedding-3-small"
    normalized: true
    timeout_seconds: 60
    batch_size: 64
  chroma:
    collection: "knowledge_base"
    persist_dir: "./chroma_db"
    timeout_seconds: 10
    allow_reset: true

ai:
  base_url: "https://api.deepseek.com"
  api_path: "/v1/chat/completions"
  api_key_env: "DEEPSEEK_API_KEY"
  model: "deepseek-chat"
  temperature: 0.4
  max_tokens: 1024
  request_timeout_ms: 60000

db:
  enabled: true
  path: "./tests/test_mock/local/reply.db"

mysql:
  enabled: false

feishu_db:
  driver: sqlite
  path: "./tests/test_mock/local/feishu_test.db"

pg: {}

feishu:
  webhook_url: ""
  bitable:
    enabled: false

toolant:
  source: "toolant"
  report_title: "Toolant 自动巡航日报（本地测试）"
  webhook_url: ""
  missing_people_info_dir: "tests/test_mock/local/logs"
