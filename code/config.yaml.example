# 复制为 config.yaml 后填写密钥；勿将 config.yaml 提交 Git（见 .gitignore）

rag:
  embed:
    base_url: "https://api.xiaocaseai.com"
    api_path: "/v1/embeddings"
    api_key_env: "HUBSTUDIO_EMBED_API_KEY"
    model: "text-embedding-3-small"
    normalized: true
    timeout_seconds: 60
    batch_size: 64
  chroma:
    collection: "knowledge_base"
    persist_dir: "./chroma_db"
    timeout_seconds: 10
    allow_reset: true
  excel:
    files:
      - "Linknlatch/AI话术参考.xlsx"
    sheet: null
    header_row: 1
    id_column: "序号"
    title_column: null
    content_column: null
    intent_column: null
    level_column: null
    metadata_columns: []

ai:
  base_url: "https://api.deepseek.com"
  api_path: "/v1/chat/completions"
  api_key_env: "DEEPSEEK_API_KEY"
  model: "deepseek-chat"
  temperature: 0.4
  max_tokens: 1024
  request_timeout_ms: 60000

db:
  enabled: true
  path: "./test_mock/local/reply.db"

mysql:
  enabled: false
  host: "127.0.0.1"
  port: 3306
  user: ""
  password_env: "MYSQL_PASSWORD"
  database: "influencer_platform"
  creator_table: "us_region_creator"
  creator_id_column: "creators_name"
  expert_quote_column: "expert_quote"
  join_wa_column: "join_WA"
  cooperation_intention_column: "cooperation_intention"
  negotiation_rounds_column: "negotiation_rounds"
  ai_reply_log_database: "controlpastmessagesdata"
  ai_reply_log_table: "auto_reply_plugin_ai_reply_info"
  connect_timeout: 10

feishu_db:
  driver: sqlite
  path: "./test_mock/local/feishu_test.db"

pg: {}

feishu:
  webhook_url: ""
  bitable:
    enabled: false
    clear_before_write: true
    app_id: ""
    app_secret_env: "FEISHU_APP_SECRET"
    app_token: ""
    table_id: ""

toolant:
  source: "toolant"
  report_title: "Toolant 自动巡航日报"
  webhook_url: ""
  missing_people_info_dir: "logs"
